generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultationRequest {
  id        String              @id @default(cuid())
  name      String
  email     String
  phone     String?
  date      DateTime
  subject   String
  message   String?
  status    ConsultationStatus  @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  clientName  String
  clientEmail String?
  date        DateTime
  time        String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Case {
  id          String     @id @default(cuid())
  title       String
  clientName  String
  clientEmail String?
  description String?
  status      CaseStatus @default(OPEN)
  practiceArea String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

enum ConsultationStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ON_HOLD
}
